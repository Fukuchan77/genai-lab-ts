# Copy to .env.local before use (.env.local is gitignored). This file lists variable names only; never
# put a value in it.
#
# AI_PROVIDER: openai | anthropic | google | ollama
AI_PROVIDER=
# Required. The model ID of the chosen provider (for Ollama, a name shown by `ollama list`)
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Ollama's OpenAI-compatible endpoint (local inference, no API key)
OLLAMA_BASE_URL=
